{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestor de Administracion",
  "version": "1.0.15",
  "identifier": "ar.com.linksolution.gestor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gestor de Administración - LinkSolution",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "LinkSolution",
    "copyright": "LinkSolution - Administración",
    "shortDescription": "Gestor de Administración",
    "longDescription": "Programa unificado de administración de LinkSolution: Facturación, DRS Ford y Master de Administración.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCQzk4ODFCRjE2MzM5QjEKUldTeE9XUHhHNGpKYXdEUFBoNkdlb2xubVlSWCtVWkJ6Tjl0Si9jWjZ6bkpwcURsY0d5NUV2OEMK",
      "endpoints": [
        "https://github.com/SofiaSampi/gestor-administracion-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
